# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
# Copy .env.example to .env.local. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo login used when the two variables above are empty.
# This is NOT security: the values end up in the browser bundle.
VITE_DEMO_ADMIN_EMAIL=admin@local
VITE_DEMO_ADMIN_PASSWORD=admin
